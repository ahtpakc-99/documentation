---
interface Props {
  variant: 'cloud' | 'desktop' | 'virtual'
}

const { variant } = Astro.props
---

<span class="homepage-highlight-graphic" aria-hidden="true">
  {
    variant === 'cloud' && (
      <svg viewBox="0 0 180 130">
        <path
          class="shape"
          d="M42 93H31a20 20 0 0 1-2-40 31 31 0 0 1 59-9 25 25 0 0 1 38 21 14 14 0 0 1-3 28h-13"
        />
        <rect class="shape" x="52" y="70" width="58" height="33" rx="6" />
        <path class="line" d="M65 81h32M65 91h22" />
        <circle cx="101" cy="91" r="3" />
      </svg>
    )
  }
  {
    variant === 'virtual' && (
      <svg viewBox="0 0 180 130">
        <path class="shape" d="M30 28 139 11v79L30 107Z" />
        <path class="shape" d="M45 42 154 25v79L45 121Z" />
        <circle cx="141" cy="36" r="3" />
        <circle cx="131" cy="38" r="3" />
        <path class="line" d="m67 78 15 11-15 17m24-5 24-4" />
      </svg>
    )
  }
  {
    variant === 'desktop' && (
      <svg viewBox="0 0 180 130">
        <rect class="shape" x="24" y="18" width="132" height="82" rx="8" />
        <path class="line" d="M24 37h132M79 100v13m-24 0h50" />
        <circle cx="36" cy="28" r="3" />
        <circle cx="46" cy="28" r="3" />
        <path class="line" d="M43 55h94M43 69h94M43 83h94" />
        <circle cx="72" cy="55" r="8" />
        <circle cx="113" cy="69" r="8" />
        <circle cx="87" cy="83" r="8" />
      </svg>
    )
  }
</span>

<style>
  .homepage-highlight-graphic {
    position: relative;
    display: grid;
    place-items: center;
    height: 9rem;
    overflow: hidden;
    border: 1px solid
      color-mix(in srgb, var(--sl-color-accent) 28%, var(--sl-color-hairline));
    border-radius: 0.85rem;
    background:
      linear-gradient(
          color-mix(in srgb, var(--sl-color-accent) 13%, transparent) 1px,
          transparent 1px
        ),
      linear-gradient(
          90deg,
          color-mix(in srgb, var(--sl-color-accent) 13%, transparent) 1px,
          transparent 1px
        ),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--sl-color-accent) 15%, var(--sl-color-bg)),
        color-mix(in srgb, var(--sl-color-accent) 5%, var(--sl-color-bg))
      );
    background-size:
      1.75rem 1.75rem,
      1.75rem 1.75rem,
      auto;
    box-shadow: var(--sl-shadow-md);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease,
      box-shadow 0.2s ease;
  }

  .homepage-highlight-graphic::after {
    position: absolute;
    inset: auto 20% -45% 20%;
    height: 70%;
    border-radius: 50%;
    background: color-mix(in srgb, var(--sl-color-accent) 18%, transparent);
    filter: blur(2rem);
    content: '';
  }

  svg {
    z-index: 1;
    width: min(72%, 8.5rem);
    height: 7rem;
    overflow: visible;
    filter: drop-shadow(0 0.75rem 1.25rem rgb(0 0 0 / 20%));
  }

  .shape {
    fill: color-mix(in srgb, var(--sl-color-accent) 15%, var(--sl-color-bg));
    stroke: var(--sl-color-text-accent);
    stroke-width: 2.5;
  }

  .line {
    fill: none;
    stroke: var(--sl-color-text-accent);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  circle {
    fill: var(--sl-color-text-accent);
    stroke: var(--sl-color-bg);
    stroke-width: 2;
  }

  :global(.homepage-highlight-card:hover) .homepage-highlight-graphic,
  :global(.homepage-highlight-card:focus-visible) .homepage-highlight-graphic {
    border-color: var(--sl-color-text-accent);
    box-shadow: 0 1.5rem 3.5rem rgb(0 0 0 / 18%);
    transform: translateY(-2px);
  }
</style>
