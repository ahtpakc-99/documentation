---
import parrotLogo from "../assets/parrot-logo.svg";

const cards = [
  {
    title: "Getting started",
    description: "Learn the basics and prepare your first Parrot installation.",
    href: "/introduction/",
    icon: "parrot",
  },
  {
    title: "Installation",
    description: "Install on bare metal, virtual machines, containers, or ARM.",
    href: "/installation/",
    icon: "terminal",
  },
  {
    title: "Configuration",
    description: "Customize your desktop, packages, network, and services.",
    href: "/configuration/",
    icon: "sliders",
  },
  {
    title: "Security & privacy",
    description: "Explore hardening, AppArmor, anonymity, and security tools.",
    href: "/tools/",
    icon: "shield",
  },
];
---

<div class="home-page">
  <section class="home-hero">
    <h1>How can we help?</h1>
    <p>Everything you need to install, configure, and master ParrotOS.</p>
  </section>

  <section class="home-grid" aria-label="Documentation categories">
    {
      cards.map((card) => (
        <a class="home-card" href={card.href}>
          <div class="card-visual">
            {card.icon === "parrot" && (
              <img src={parrotLogo.src} alt="" width="92" height="92" />
            )}
            {card.icon === "terminal" && (
              <svg class="card-icon terminal" viewBox="0 0 180 130" aria-hidden="true">
                <path d="M34 24 143 7v81L34 117Z"></path>
                <path d="M49 38 158 21v81L49 131Z"></path>
                <circle cx="145" cy="32" r="3"></circle>
                <circle cx="136" cy="34" r="3"></circle>
                <path class="line" d="m69 84 14 10-14 16m21-4 20-4"></path>
              </svg>
            )}
            {card.icon === "sliders" && (
              <svg class="card-icon sliders" viewBox="0 0 160 130" aria-hidden="true">
                <path class="line" d="M25 35h110M25 65h110M25 95h110"></path>
                <circle cx="59" cy="35" r="13"></circle>
                <circle cx="107" cy="65" r="13"></circle>
                <circle cx="73" cy="95" r="13"></circle>
              </svg>
            )}
            {card.icon === "shield" && (
              <svg class="card-icon shield" viewBox="0 0 150 150" aria-hidden="true">
                <path d="M75 10 128 30v39c0 35-20 58-53 72-33-14-53-37-53-72V30Z"></path>
                <path class="line" d="m52 74 16 16 32-39"></path>
              </svg>
            )}
          </div>
          <h2>{card.title}</h2>
          <p>{card.description}</p>
        </a>
      ))
    }
  </section>
</div>

<script>
  document.querySelectorAll("[data-home-search]").forEach((button) => {
    button.addEventListener("click", () => {
      document
        .querySelector<HTMLButtonElement>("site-search button[data-open-modal]")
        ?.click();
    });
  });
</script>

<style>
  .home-page {
    width: min(100%, 880px);
    margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) 1rem 5rem;
    position: relative;
  }

  .home-page::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: -8rem;
    left: 50%;
    width: min(80vw, 760px);
    height: 420px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
    filter: blur(90px);
    pointer-events: none;
  }

  .home-hero {
    text-align: center;
  }

  .eyebrow {
    width: fit-content;
    margin: 0 auto 1.25rem;
    padding: 0.4rem 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 35%, var(--sl-color-hairline));
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-accent) 9%, var(--sl-color-bg));
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-2xs);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
    box-shadow: 0 0 0.8rem var(--sl-color-accent);
  }

  h1 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: clamp(2.5rem, 7vw, 4rem);
    letter-spacing: -0.045em;
  }

  .home-hero > p {
    margin: 1rem auto 0;
    color: var(--sl-color-text-muted);
    font-size: clamp(1rem, 2vw, 1.1rem);
  }

  .home-search {
    width: min(100%, 590px);
    min-height: 3.5rem;
    margin: 2rem auto 0;
    padding: 0.75rem 0.85rem 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--sl-color-bg) 88%, var(--sl-color-accent) 12%);
    color: var(--sl-color-text-muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
    box-shadow: var(--sl-shadow-sm);
  }

  .home-search:hover,
  .home-search:focus-visible {
    border-color: var(--sl-color-accent);
  }

  .home-search svg {
    width: 1.25rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .home-search span {
    flex: 1;
  }

  .home-search kbd {
    padding: 0.25rem 0.45rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.35rem;
    background: var(--sl-color-bg-inline-code);
    color: var(--sl-color-text-muted);
    font-size: var(--sl-text-xs);
  }

  .home-grid {
    margin-top: clamp(3.5rem, 8vw, 5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.25rem 1.5rem;
  }

  .home-card {
    color: inherit;
    text-decoration: none;
  }

  .card-visual {
    height: 148px;
    display: grid;
    place-items: center;
    overflow: hidden;
    position: relative;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 28%, var(--sl-color-hairline));
    border-radius: 0.85rem;
    background:
      linear-gradient(color-mix(in srgb, var(--sl-color-accent) 13%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--sl-color-accent) 13%, transparent) 1px, transparent 1px),
      linear-gradient(
        135deg,
        color-mix(in srgb, var(--sl-color-accent) 15%, var(--sl-color-bg)),
        color-mix(in srgb, var(--sl-color-accent) 5%, var(--sl-color-bg))
      );
    background-size: 28px 28px, 28px 28px, auto;
    box-shadow: var(--sl-shadow-md);
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .home-card:hover .card-visual,
  .home-card:focus-visible .card-visual {
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
  }

  .card-visual img {
    width: 86px;
    height: 86px;
    filter: drop-shadow(0 0.8rem 1.5rem rgb(0 0 0 / 30%));
  }

  .card-icon {
    width: 118px;
    height: 96px;
    overflow: visible;
  }

  .card-icon path:not(.line) {
    fill: color-mix(in srgb, var(--sl-color-accent) 17%, var(--sl-color-bg));
    stroke: var(--sl-color-accent-high);
    stroke-width: 2;
  }

  .card-icon circle {
    fill: color-mix(in srgb, var(--sl-color-accent) 19%, var(--sl-color-bg));
    stroke: var(--sl-color-accent-high);
    stroke-width: 3;
  }

  .card-icon .line {
    fill: none;
    stroke: var(--sl-color-accent-high);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .shield {
    width: 94px;
    height: 94px;
  }

  .home-card h2 {
    margin: 1rem 0 0;
    color: var(--sl-color-white);
    font-size: var(--sl-text-lg);
  }

  .home-card p {
    margin: 0.35rem 0 0;
    color: var(--sl-color-text-muted);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }

  @media (max-width: 40rem) {
    .home-page {
      padding-top: 2.5rem;
    }

    .home-grid {
      grid-template-columns: 1fr;
    }

    .home-search span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
  }
</style>
