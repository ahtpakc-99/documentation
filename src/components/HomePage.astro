---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const featuredDocs = [
  {
    category: "Containers",
    title: "Docker Images",
    description: "Run Parrot containers and choose from ready-to-use images for different security workflows.",
    href: `${base}/containers/parrot-on-docker/`,
  },
  {
    category: "Virtualization",
    title: "UTM",
    description: "Run a pre-configured Parrot virtual machine on Apple Silicon Macs using UTM.",
    href: `${base}/virtualization/utm-configuration/`,
  },
  {
    category: "Configuration",
    title: "Desktop Environments",
    description: "Explore KDE Plasma and the additional desktop environments available for ParrotOS.",
    href: `${base}/configuration/desktop-environments/`,
  },
  {
    category: "Introduction",
    title: "What is Parrot?",
    description: "Learn about ParrotOS, its editions, security tools, development features, and privacy focus.",
    href: `${base}/introduction/what-is-parrot/`,
  },
];
---

<div
  class="home-page"
>
  <section class="home-hero">
    <h1>How can we help?</h1>
    <p>Everything you need to install, configure, and master ParrotOS.</p>
    <button
      class="home-search"
      type="button"
      data-home-search
      aria-keyshortcuts="Control+K"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m16 16 5 5"></path>
      </svg>
      <span>Search the documentation</span>
      <kbd data-home-search-shortcut>Ctrl K</kbd>
    </button>
  </section>

  <a class="home-button" href={`${base}/introduction/what-is-parrot`}>Get Started</a>

  <section class="featured-docs" aria-labelledby="featured-docs-title">
    <div class="featured-header">
      <h2 id="featured-docs-title">Featured documents</h2>
      <p>Start with some of the most useful ParrotOS guides.</p>
    </div>

    <div class="home-grid">
      {
        featuredDocs.map((doc) => (
          <a class="home-card" href={doc.href}>
            <div class="card-copy">
              <span class="card-category">{doc.category}</span>
              <h2>{doc.title}</h2>
              <p>{doc.description}</p>
            </div>
            <span class="card-action">
              Read guide
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m9 5 7 7-7 7"></path>
              </svg>
            </span>
          </a>
        ))
      }
    </div>
  </section>
</div>

<script>
  const homeSearch = document.querySelector<HTMLElement>("[data-home-search]");
  const shortcut = document.querySelector<HTMLElement>("[data-home-search-shortcut]");
  const isApplePlatform = /Mac|iPhone|iPad|iPod/i.test(navigator.platform);

  if (homeSearch && shortcut && isApplePlatform) {
    shortcut.textContent = "⌘ K";
    homeSearch.setAttribute("aria-keyshortcuts", "Meta+K");
  }

  document.querySelectorAll("[data-home-search]").forEach((button) => {
    button.addEventListener("click", (event) => {
      event.stopPropagation();
      document
        .querySelector<HTMLButtonElement>("site-search button[data-open-modal]")
        ?.click();
    });
  });
</script>

<style>
  .home-page {
    width: min(100%, 1450px);
    min-height: calc(100dvh - var(--sl-nav-height) - var(--sl-mobile-toc-height));
    margin: 0 auto;
    padding: clamp(0.75rem, 2vh, 1.5rem) 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    gap: clamp(1.5rem, 3vh, 2.5rem);
    position: relative;
    isolation: isolate;
  }


  :global(:root[data-theme="light"]) .home-page::before {
    opacity: .7;
  }

  :global(main:has(.home-page) footer) {
    display: none;
  }

  :global(body:has(.home-page) .page > header.header) {
    border-bottom-color: color-mix(
      in srgb,
      var(--sl-color-hairline-shade) 55%,
      transparent
    );
  }

  :global(.content-panel:has(.home-page)) {
    padding-block: 0;
  }

  :global(main:has(.home-page)) {
    overflow: clip;
  }

  .home-hero {
    text-align: center;
  }

  .home-button {
    padding: 0.4rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border-radius: .3rem;
    border: none;
    background: var(--sl-color-accent);
    color: var(--sl-color-text-secondary);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    box-shadow: var(--sl-shadow-sm);
  }

  .eyebrow {
    width: fit-content;
    margin: 0 auto 1.25rem;
    padding: 0.4rem 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 35%, var(--sl-color-hairline));
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-accent) 9%, var(--sl-color-bg));
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-2xs);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
    box-shadow: 0 0 0.8rem var(--sl-color-accent);
  }

  h1 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: clamp(2.25rem, 6vw, 3.25rem);
    letter-spacing: -0.045em;
  }

  .home-hero > p {
    margin: 0.5rem auto 0;
    color: var(--sl-color-text-muted);
    font-size: clamp(1rem, 2vw, 1.1rem);
  }

  .home-search {
    width: min(100%, 590px);
    min-height: 3rem;
    margin: 1rem auto 0;
    padding: 0.6rem 0.75rem 0.6rem 0.9rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.75rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text-muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
    box-shadow: var(--sl-shadow-sm);
    transition: border-color 0.5s ease;
  }

  .home-search:hover,
  .home-search:focus-visible {
    border-color: #00B8DB70;
  }

  .home-search svg {
    width: 1.25rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .home-search span {
    flex: 1;
  }

  .home-search kbd {
    padding: 0.25rem 0.45rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.35rem;
    background: transparent;
    color: var(--sl-color-text-muted);
    font-size: var(--sl-text-xs);
  }

  .featured-docs {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .featured-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    text-align: left;
  }

  .featured-header h2 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: clamp(1.35rem, 3vw, 1.75rem);
    letter-spacing: -0.03em;
  }

  .featured-header p {
    margin: 0;
    color: var(--sl-color-text-muted);
    font-size: 1rem;
  }

  .home-grid {
    margin-top: 0.75rem;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.5rem;
  }

  .home-card {
    --card-accent: var(--sl-color-accent);
    padding: 0.65rem 0.9rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    border: 1px solid #00B8DB33;
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--sl-color-bg) 91%, var(--sl-color-gray-6));
    color: var(--sl-color-text);
    text-decoration: none;
    box-shadow: 0 0.75rem 2rem rgb(0 0 0 / 5%);
    transition:
      border-color 0.5s ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .home-card:hover,
  .home-card:focus-visible {
    border-color: #00B8DB70;
    transform: translateY(-1px);
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 8%);
  }

  .card-copy {
    margin-top: 0;
  }

  .card-category {
    display: block;
    margin-bottom: 0.1rem;
    color: var(--sl-color-accent);
    font-size: var(--sl-text-xs);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .home-card h2 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: clamp(1.1rem, 2vw, 1.25rem);
    font-weight: 500;
  }

  .home-card p {
    margin: 0.15rem 0 0;
    color: var(--sl-color-text-muted);
    font-size: var(--sl-text-sm);
    line-height: 1.45;
  }

  .card-action {
    margin-top: 0;
    padding-top: 0;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--sl-color-accent);
    font-size: 1rem;
    font-weight: 500;
  }

  .card-action svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 160ms ease;
  }

  .home-card:hover .card-action svg,
  .home-card:focus-visible .card-action svg {
    transform: translateX(0.2rem);
  }

  @media (max-width: 40rem) {
    .home-page {
      padding-top: 0.75rem;
    }

    .home-search span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .home-search kbd {
      display: none;
    }

    .featured-header {
      display: block;
    }

    .featured-header p {
      margin-top: 0.2rem;
      font-size: var(--sl-text-sm);
    }
  }
</style>
