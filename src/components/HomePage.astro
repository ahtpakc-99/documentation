---
import parrotPattern from "../assets/parrot.svg";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const cards = [
  {
    title: "Getting started",
    description: "Learn the basics and prepare your first Parrot installation.",
    href: `${base}/introduction/`,
    icon: "parrot",
    action: "Get started",
  },
  {
    title: "Installation",
    description: "Install on bare metal, virtual machines, containers, or ARM.",
    href: `${base}/installation/`,
    icon: "terminal",
    action: "Install Parrot",
  },
  {
    title: "Configuration",
    description: "Customize your desktop, packages, network, and services.",
    href: `${base}/configuration/`,
    icon: "sliders",
    action: "Configure",
  },
  {
    title: "Security & privacy",
    description: "Explore hardening, AppArmor, anonymity, and security tools.",
    href: `${base}/tools/`,
    icon: "shield",
    action: "Explore tools",
  },
];
---

<div
  class="home-page"
  style={`--parrot-pattern: url("${parrotPattern.src}")`}
>
  <section class="home-hero">
    <h1>How can we help?</h1>
    <p>Everything you need to install, configure, and master ParrotOS.</p>
    <button
      class="home-search"
      type="button"
      data-home-search
      aria-keyshortcuts="Control+K"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m16 16 5 5"></path>
      </svg>
      <span>Search the documentation</span>
      <kbd data-home-search-shortcut>Ctrl K</kbd>
    </button>
  </section>

  <a class="home-button" href={`${base}/introduction/what-is-parrot`}>Get Started</a>
</div>

<script>
  const homeSearch = document.querySelector<HTMLElement>("[data-home-search]");
  const shortcut = document.querySelector<HTMLElement>("[data-home-search-shortcut]");
  const isApplePlatform = /Mac|iPhone|iPad|iPod/i.test(navigator.platform);

  if (homeSearch && shortcut && isApplePlatform) {
    shortcut.textContent = "⌘ K";
    homeSearch.setAttribute("aria-keyshortcuts", "Meta+K");
  }

  document.querySelectorAll("[data-home-search]").forEach((button) => {
    button.addEventListener("click", (event) => {
      event.stopPropagation();
      document
        .querySelector<HTMLButtonElement>("site-search button[data-open-modal]")
        ?.click();
    });
  });
</script>

<style>
  .home-page {
    width: min(100%, 1450px);
    min-height: calc(100dvh - var(--sl-nav-height) - var(--sl-mobile-toc-height) - 3rem);
    margin: 0 auto;
    padding: clamp(1.5rem, 4vh, 3rem) 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    gap: 2rem;
    position: relative;
    isolation: isolate;
  }

  .home-page::before {
    content: "";
    position: absolute;
    z-index: -1;
    top: 0;
    bottom: 50%;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    background-image: var(--parrot-pattern);
    background-position: center top;
    background-repeat: repeat;
    background-size: clamp(8rem, 12vw, 11rem);
    opacity: 0.3;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 35%, transparent 100%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 35%, transparent 100%);
    pointer-events: none;
  }

  :global(:root[data-theme="light"]) .home-page::before {
    opacity: .7;
  }

  :global(main:has(.home-page) footer) {
    display: none;
  }

  :global(main:has(.home-page)) {
    overflow: clip;
  }

  .home-hero {
    text-align: center;
  }

  .home-button {
    padding: .5rem 2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    border-radius: .3rem;
    border: none;
    background: var(--sl-color-accent);
    color: var(--sl-color-text-secondary);
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    box-shadow: var(--sl-shadow-sm);
  }

  .eyebrow {
    width: fit-content;
    margin: 0 auto 1.25rem;
    padding: 0.4rem 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid color-mix(in srgb, var(--sl-color-accent) 35%, var(--sl-color-hairline));
    border-radius: 999px;
    background: color-mix(in srgb, var(--sl-color-accent) 9%, var(--sl-color-bg));
    color: var(--sl-color-text-accent);
    font-size: var(--sl-text-2xs);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .eyebrow span {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
    box-shadow: 0 0 0.8rem var(--sl-color-accent);
  }

  h1 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: clamp(2.5rem, 7vw, 4rem);
    letter-spacing: -0.045em;
  }

  .home-hero > p {
    margin: 1rem auto 0;
    color: var(--sl-color-text-muted);
    font-size: clamp(1rem, 2vw, 1.1rem);
  }

  .home-search {
    width: min(100%, 590px);
    min-height: 3.5rem;
    margin: 2rem auto 0;
    padding: 0.75rem 0.85rem 0.75rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.75rem;
    background: transparent;
    color: var(--sl-color-text-muted);
    font: inherit;
    text-align: left;
    cursor: pointer;
    box-shadow: var(--sl-shadow-sm);
  }

  .home-search:hover,
  .home-search:focus-visible {
    border-color: var(--sl-color-accent);
  }

  .home-search svg {
    width: 1.25rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .home-search span {
    flex: 1;
  }

  .home-search kbd {
    padding: 0.25rem 0.45rem;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: 0.35rem;
    background: transparent;
    color: var(--sl-color-text-muted);
    font-size: var(--sl-text-xs);
  }

  .home-grid {
    margin-top: clamp(3.5rem, 8vw, 5rem);
    display: grid;
    grid-template-columns: 1fr 1fr 1fr 1fr;
    gap: 1.5rem;
  }

  .home-card {
    --card-accent: var(--sl-color-accent);
    min-height: 290px;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    display: flex;
    flex-direction: column;
    border: 1px solid color-mix(in srgb, var(--card-accent) 28%, var(--sl-color-hairline));
    border-radius: 1rem;
    background: color-mix(in srgb, var(--sl-color-bg) 91%, var(--sl-color-gray-6));
    color: var(--sl-color-text);
    text-decoration: none;
    box-shadow: 0 1.5rem 4rem rgb(0 0 0 / 8%);
    transition: border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;
  }

  .home-card:hover,
  .home-card:focus-visible {
    border-color: var(--card-accent);
    transform: translateY(-3px);
    box-shadow: 0 1.75rem 4.5rem rgb(0 0 0 / 16%);
  }

  .card-icon-frame {
    width: 4.15rem;
    height: 4.15rem;
    display: grid;
    place-items: center;
    border-radius: 1rem;
    background: color-mix(in srgb, var(--sl-color-bg) 94%, var(--card-accent));
    color: var(--sl-color-white);
  }

  .card-icon-frame img {
    width: 2.5rem;
    height: 2.5rem;
    filter: brightness(0) invert(1);
  }

  .card-icon {
    width: 2.6rem;
    height: 2.6rem;
    overflow: visible;
  }

  .card-icon path:not(.line) {
    fill: none;
    stroke: currentColor;
    stroke-width: 5;
  }

  .card-icon circle {
    fill: currentColor;
    stroke: none;
  }

  .card-icon .line {
    fill: none;
    stroke: currentColor;
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .shield {
    width: 2.35rem;
    height: 2.35rem;
  }

  .card-copy {
    margin-top: 1.6rem;
  }

  .home-card h2 {
    margin: 0;
    color: var(--sl-color-white);
    font-size: clamp(1.25rem, 3vw, 1.5rem);
    font-weight: 500;
  }

  .home-card p {
    margin: 0.55rem 0 0;
    color: var(--sl-color-text-muted);
    font-size: 1rem;
    line-height: 1.6;
  }

  .card-action {
    margin-top: auto;
    padding-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--sl-color-accent);
    font-size: 1rem;
    font-weight: 500;
  }

  .card-action svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 160ms ease;
  }

  .home-card:hover .card-action svg,
  .home-card:focus-visible .card-action svg {
    transform: translateX(0.2rem);
  }

  @media (max-width: 40rem) {
    .home-page {
      padding-top: 2.5rem;
    }

    .home-grid {
      grid-template-columns: 1fr;
    }

    .home-search span {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .home-search kbd {
      display: none;
    }
  }
</style>
