---
import { logos } from "virtual:starlight/user-images";

const { siteTitleHref } = Astro.locals.starlightRoute;
const logo = logos.dark;
---

<a href={siteTitleHref} class="site-title sl-flex" aria-label="ParrotOS Docs">
  {
    logo && (
      <img
        alt=""
        src={logo.src}
        width={logo.width}
        height={logo.height}
      />
    )
  }
  <span class="title" translate="no">
    <span class="product">ParrotOS</span>
    <span class="docs">Docs</span>
  </span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: var(--sl-nav-gap);
    font-size: var(--sl-text-h4);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }

  .title {
    display: flex;
    gap: 0.35em;
    overflow: hidden;
  }

  .product {
    color: var(--sl-color-white);
  }

  .docs {
    color: var(--sl-color-text-muted);
  }

  img {
    height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: 0 50%;
  }
</style>
