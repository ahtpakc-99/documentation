---
import Default from "@astrojs/starlight/components/PageTitle.astro";

const { id, entry } = Astro.locals.starlightRoute;
const isHomepage = id === "";
---

{
  isHomepage
    ? <h1 id="_top" class="homepage-title-placeholder sr-only">{entry.data.title}</h1>
    : <Default />
}

<style is:global>
  .content-panel:has(.homepage-title-placeholder) {
    height: 0;
    padding-block: 0;
  }

  .content-panel:has(.homepage-title-placeholder) + .content-panel {
    border-top: 0;
  }
</style>
