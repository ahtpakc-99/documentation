    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.9.2",
    "@docusaurus/tsconfig": "^3.9.2",
    "@docusaurus/types": "^3.9.2",
    "@types/react": "^18.2.29",
    "pagefind": "^1.5.2",
    "typescript": "~5.2.2"
  },
  "engines": {
